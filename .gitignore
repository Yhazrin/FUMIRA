# macOS
.DS_Store

# Xcode / user state
**/xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Secrets & local env
.env
.env.local
.env.*.local
**/.env

# Server runtime data
server/node_modules/
server/dist/
server/uploads/
server/generated/
server/data/
server/coverage/
*.log

# Binary / captured media (never commit originals or base64 dumps)
*.heic
*.HEIC
**/fixtures/private/
**/tmp-base64/

# Swift Package Manager
.swiftpm/
Package.resolved

# XcodeGen derived build directory and ad-hoc snapshot dumps
.build/
.xcconfig
.tmp-*.png
.tmp-*.jpg

# Generated pixel-sequence / visual build outputs (rebuilt via tools/build_pixel_sequences.py)
artifacts/
tools/__pycache__/
**/__pycache__/

# Node
node_modules/
dist/
coverage/
.cache/
*.tsbuildinfo

# Build artifacts (demo workspace)
demo/*/dist/
demo/*/node_modules/
demo/*/.vite/

# Third-party nested clone (keep out of main repo)
demo/image-blaster/

# Temporary
*.tmp

# Screenshots (test artifacts)
screenshots/
test-screenshots/

# IDE
.idea/
.vscode/
*.swp
*.swo
