# FUMIRA server environment template.
# Copy to .env and fill values. Never commit .env or API keys.

# Required for real MiniMax I2I generation.
MINIMAX_API_KEY=

# Optional API Mart relay for GPT-Image-2 image-to-image generation.
# The iOS app selects this route by ID; this credential stays server-side.
APIMART_API_KEY=
# APIMART_API_BASE_URL=https://api.apimart.ai
# APIMART_TIMEOUT_MS=420000
# Optional per-provider DNS override when a local resolver returns 0.0.0.0.
# APIMART_RESOLVE_IP=104.26.11.94

# Bearer token for /v1/admin/* and admin settings mutations.
ADMIN_TOKEN=change-me-demo-admin-token

# HTTP listen port (default 8787).
PORT=8787

# Public base URL used when building result download links for the app.
# Example: http://127.0.0.1:8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# When true, use the in-process mock MiniMax adapter (no network, no API key).
# Useful for CI and local flow tests without a real key.
MINIMAX_MOCK=false

# Demo kill-switch: when false, new generations are rejected as unavailable.
REMOTE_GENERATION_ENABLED=true

# Controlled prompt wrapper. Placeholders: {{prompt}}, {{timeLabel}}, {{aspectRatio}}
PROMPT_TEMPLATE={{prompt}}

# Outbound proxy for MiniMax HTTPS (and optional npm). Local project proxy:
#   http://127.0.0.1:7990
# Resolution order for MiniMax: MINIMAX_HTTPS_PROXY → HTTPS_PROXY → HTTP_PROXY.
HTTPS_PROXY=http://127.0.0.1:7990
HTTP_PROXY=http://127.0.0.1:7990
# Optional override used only by the MiniMax adapter:
# MINIMAX_HTTPS_PROXY=http://127.0.0.1:7990
