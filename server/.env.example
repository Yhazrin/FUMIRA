# FUMIRA server environment template.
# Copy to .env and fill values. Never commit .env or API keys.

# Required for real MiniMax image generation and temporal text planning.
MINIMAX_API_KEY=

# Optional separate Coding Plan VLM credential for SceneGraph analysis and
# post-generation image analysis. Falls back to MINIMAX_API_KEY when omitted.
MINIMAX_VLM_API_KEY=

# Optional model overrides.
MINIMAX_STORY_MODEL=MiniMax-M3
MINIMAX_TEXT_MODEL=MiniMax-M2.7-highspeed

# Bearer token for /v1/admin/* and admin settings mutations.
ADMIN_TOKEN=change-me-demo-admin-token

# HTTP listen port (default 8787).
PORT=8787

# Public base URL used when building result download links for the app.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# When true, use the in-process mock image-generation adapter.
MINIMAX_MOCK=false

# Kill-switch: when false, new generations are rejected as unavailable.
REMOTE_GENERATION_ENABLED=true

# V3 visual critic and controlled repair pass.
VISUAL_CRITIC_ENABLED=true
VISUAL_CRITIC_MAX_REGENERATIONS=1
VISUAL_CRITIC_CAMERA_THRESHOLD=0.78
VISUAL_CRITIC_CHANGE_THRESHOLD=0.72
VISUAL_CRITIC_ENVIRONMENT_THRESHOLD=0.62
VISUAL_CRITIC_ERA_THRESHOLD=0.72

# Legacy-only prompt template. V2 and V3 structured requests use PromptCompilerV3.
PROMPT_TEMPLATE=Based on the source photo, generate the same place at {{timeLabel}}. Story: {{story}}. Keep original composition, camera angle, and main subject identity. No extra people or text.

# Optional outbound proxy for MiniMax HTTPS.
# Resolution: MINIMAX_HTTPS_PROXY -> HTTPS_PROXY -> HTTP_PROXY.
# Local example: http://127.0.0.1:7990
MINIMAX_HTTPS_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
